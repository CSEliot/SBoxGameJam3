		<Reference Include="/home/cseliot/.local/share/Steam/steamapps/common/sbox/bin/managed/Sandbox.AppSystem.dll"/> 
		<Reference Include="/home/cseliot/.local/share/Steam/steamapps/common/sbox/bin/managed/Sandbox.Tools.dll"/> 
