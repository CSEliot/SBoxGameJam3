@namespace Sandbox.UI

@using System
@using Sandbox
@using Sandbox.UI

@inherits PanelComponent

<root>
	@if ( Visible )
	{
		<div class="backdrop"></div>

		<div class="content">
			<div class="leaderboard">
				<div class="lb-title">BEST DRUNKARDS</div>
				@foreach ( var row in TopRows )
				{
					<div class="lb-row rank-@( row.Rank ) @( row.IsLocal ? "local" : "" )">
						<div class="lb-rank">@( row.Rank ).</div>
						<div class="lb-name">@( row.Entry.DisplayName )</div>
						<div class="lb-score">@( ( (int)row.Entry.Value ).ToString( "D4" ) )</div>
					</div>
				}
			</div>

			<div class="menu-column">
				<div class="title">SBOXGAMEJAM3</div>

				<div class="buttons">
					<div class="button play" onclick=@PlayClicked>PLAY</div>
					<div class="button settings" onclick=@SettingsClicked>SETTINGS</div>
					<div class="button howtoplay" onclick=@HowToPlayClicked>HOW TO PLAY</div>
					<div class="button credits" onclick=@CreditsClicked>CREDITS</div>
					<div class="button quit" onclick=@QuitClicked>QUIT</div>
				</div>
			</div>
		</div>

		@if ( ShowHowToPlay )
		{
			<div class="howtoplay-backdrop" onclick=@CloseHowToPlay></div>
			<div class="howtoplay-modal">
				<div class="htp-title">HOW TO PLAY</div>

				<div class="htp-page">
					<div class="htp-image"></div>
					@if ( CurrentPage == 0 )
					{
						<div class="htp-heading">How to Win</div>
					}
					else if ( CurrentPage == 1 )
					{
						<div class="htp-heading">How to Win:</div>
						<div class="htp-line">Run to the next pub as indicated by the arrow above your head, and chug Chug CHUG!!</div>
					}
					else if ( CurrentPage == 2 )
					{
						<div class="htp-heading">How to Win:</div>
						<div class="htp-line">Every second, you gain points based on how drunk you are.</div>
					}
					else if ( CurrentPage == 3 )
					{
						<div class="htp-heading">How to Win:</div>
						<div class="htp-line">The more you drink, the harder the game. You move faster and it's easier to fall over.</div>
					}
					else if ( CurrentPage == 4 )
					{
						<div class="htp-heading">How to Win:</div>
						<div class="htp-line">Don't worry! The more you drink, the more time gets added for you to make it to the next bar!</div>
					}
					else if ( CurrentPage == 5 )
					{
						<div class="htp-heading">Controls</div>
					}
					else if ( CurrentPage == 6 )
					{
						<div class="htp-heading">Controls:</div>
						<div class="htp-line">Hold Shift: Keep your pants up! (still working on the graphics for this, please rely on the pants graphic to the right.)</div>
					}
					else if ( CurrentPage == 7 )
					{
						<div class="htp-heading">Controls:</div>
						<div class="htp-line">A / D: Tilt left and right.</div>
					}
					else if ( CurrentPage == 8 )
					{
						<div class="htp-heading">Controls:</div>
						<div class="htp-line">Forward: This is automatic, you're always going forward.</div>
					}
					else if ( CurrentPage == 9 )
					{
						<div class="htp-heading">Controls:</div>
						<div class="htp-line">Backwards: You can't! But let go of shift to drop your pants and lower your speed!</div>
					}
					else if ( CurrentPage == 10 )
					{
						<div class="htp-heading">Controls:</div>
						<div class="htp-line">Spacebar: Jump!</div>
					}
					else if ( CurrentPage == 11 )
					{
						<div class="htp-heading">Controls:</div>
						<div class="htp-line">Escape: Opening the Escape Menu.</div>
					}
					else if ( CurrentPage == 12 )
					{
						<div class="htp-heading">How to Lose</div>
					}
					else if ( CurrentPage == 13 )
					{
						<div class="htp-heading">How to Lose:</div>
						<div class="htp-line">If your timer runs out (top left) you lose ALL YOUR POINTS. So every pub you hit, decide: Cash in or risk it all for ...</div>
						<div class="htp-line htp-shout">ANOTHER ROUND!!</div>
					}
				</div>

				<div class="htp-nav">
					<div class="htp-arrow" onclick=@PrevPage>&lt;</div>
					<div class="htp-counter">@( CurrentPage + 1 ) / @PageCount</div>
					<div class="htp-arrow" onclick=@NextPage>&gt;</div>
				</div>
				<div class="htp-hint">A / D or LEFT / RIGHT ARROWS to flip pages</div>
				<div class="button close" onclick=@CloseHowToPlay>CLOSE</div>
			</div>
		}

		@if ( ShowCredits )
		{
			<div class="credits-backdrop" onclick=@CloseCredits></div>
			<div class="credits-modal">
				<div class="credits-title">CREDITS</div>
				<div class="credits-body">Glasses models: CGTrader / mdaniel112</div>
				<div class="button close" onclick=@CloseCredits>CLOSE</div>
			</div>
		}
	}
</root>

@code
{
	/// <summary>
	/// The scene's GameManager - source of the local game state gating this panel and
	/// owner of StartGame(). Set this explicitly in the scene (do NOT rely on
	/// GetComponent on this panel's own GameObject - the menu panel and GameManager
	/// live on different objects). Unwired = menu stays hidden (fail-closed, like Hud).
	/// </summary>
	[Property] private GameManager _GameManager { get; set; }

	/// <summary>How many leaderboard rows to show, mirrors EndGame's _DisplayTopCount but
	/// smaller since this shares the screen with the menu column rather than owning it.</summary>
	[Property] private int _DisplayTopCount { get; set; } = 5;

	/// <summary>One leaderboard row as rendered on this screen, mirrors EndGame.Row.</summary>
	public readonly struct Row
	{
		public int Rank { get; init; }
		public Sandbox.Services.Leaderboards.Board2.Entry Entry { get; init; }
		public bool IsLocal { get; init; }
	}

	public bool ShowCredits { get; private set; }
	public bool ShowHowToPlay { get; private set; }

	/// <summary>How-to-play modal pages: a cover page per section (Win / Controls /
	/// Lose) plus one page per rules line, so each page has room for its own image.</summary>
	private const int PageCount = 14;
	private int CurrentPage;

	/// <summary>The panel renders only while the local client is in the main-menu
	/// state; a null (unwired) GameManager keeps it hidden.</summary>
	private bool Visible => _GameManager is not null &&
		_GameManager.GetLocalGameState() == GameManager.LocalGameState.InMainMenu;

	private Sandbox.Services.Leaderboards.Board2 _leaderboard;
	private bool _leaderboardLoaded;
	private int _refreshKey;

	protected override void OnStart()
	{
		if ( _GameManager is null )
			Log.Warning( "MainMenu: _GameManager is not wired - the menu will stay hidden." );

		_leaderboard = Sandbox.Services.Leaderboards.GetFromStat( "score" );
		_leaderboard.SetSortDescending();
		_leaderboard.MaxEntries = 100;
	}

	protected override void OnUpdate()
	{
		// Page navigation while the how-to-play modal is up. Raw KeyboardCode names
		// (KeyTranslation lookup is case-insensitive), same style as Hud's "P" and
		// Minigame's "space". Only when visible - A/D are gameplay keys elsewhere.
		if ( Visible && ShowHowToPlay )
		{
			if ( Input.Keyboard.Pressed( "a" ) || Input.Keyboard.Pressed( "leftarrow" ) )
				PrevPage();
			else if ( Input.Keyboard.Pressed( "d" ) || Input.Keyboard.Pressed( "rightarrow" ) )
				NextPage();
		}

		if ( !_leaderboardLoaded && _leaderboard != null )
		{
			_ = RefreshLeaderboardAsync();
		}
	}

	private async System.Threading.Tasks.Task RefreshLeaderboardAsync()
	{
		if ( _leaderboard == null )
			return;

		// Guard against firing a second overlapping refresh while the first is in flight -
		// OnUpdate keeps calling this every frame until _leaderboardLoaded flips true.
		_leaderboardLoaded = true;

		await _leaderboard.Refresh();
		_refreshKey++;
	}

	private IReadOnlyList<Sandbox.Services.Leaderboards.Board2.Entry> Leaderboard => _leaderboard?.Entries ?? Array.Empty<Sandbox.Services.Leaderboards.Board2.Entry>();

	private List<Row> TopRows
	{
		get
		{
			var list = Leaderboard;
			SteamId localSteamId = Connection.Local?.SteamId ?? default;
			var rows = new List<Row>();
			int count = Math.Min( _DisplayTopCount, list.Count );
			for ( int i = 0; i < count; i++ )
			{
				rows.Add( new Row { Rank = i + 1, Entry = list[i], IsLocal = list[i].SteamId == localSteamId } );
			}
			return rows;
		}
	}

	private void PlayClicked()
	{
		if ( !Visible )
			return;

		_GameManager.StartGame();
	}

	private void SettingsClicked()
	{
		Game.Overlay.ShowSettingsModal();
	}

	private void HowToPlayClicked()
	{
		CurrentPage = 0;
		ShowHowToPlay = true;
	}

	private void CloseHowToPlay()
	{
		ShowHowToPlay = false;
	}

	private void PrevPage()
	{
		if ( CurrentPage > 0 )
			CurrentPage--;
	}

	private void NextPage()
	{
		if ( CurrentPage < PageCount - 1 )
			CurrentPage++;
	}

	private void CreditsClicked()
	{
		ShowCredits = true;
	}

	private void CloseCredits()
	{
		ShowCredits = false;
	}

	private void QuitClicked()
	{
		Game.Close();
	}

	protected override int BuildHash() => HashCode.Combine( Visible, ShowCredits, ShowHowToPlay, CurrentPage, _refreshKey );
}
