// Description:
// Pub-crawling HUD overlay (Design.md, Screen 1). Always-visible-during-run
// readout of Timer (top-left), Score (top-center) and Drunkenness (top-right).
// Read-only view over the local player's PlayerProgress/DrunkCC, resolved via
// a [Property] GameManager ref. Hidden during the mini-game (that overlay owns
// the screen) and before the player has spawned. Markup only; display formatting
// lives in Hud.razor.cs.
//
// Also hosts the TARGET-BAR PREVIEW: a ScenePanel (the <scene> tag) rendering the
// current target bar's -JustModel prefab spinning slowly on a slight kilter,
// bottom-left, above the controls hint. Shown under the same Visible gate as the
// HUD body (live run on the street), so it never floats over the menu, the bar
// screens, or the End-Game overlay. Scene setup/spin lives in Hud.razor.cs
// (UpdateTargetBarPreviewHelper). Because ScenePanel composites into the UI layer
// (ScreenPanel, AfterPostProcess), the preview always draws ON TOP of in-world
// models.
//
// Not implemented here: the PANTS METER (Design Screen 1, bottom-left) - a debug
// readout of DrunkCC.CurrentPantsState (Up/Down, F2-toggleable) was added on the
// right edge instead, see pants-debug in Hud.razor/scss.
// The Arrow Indicator is a 3D world-space model (the event-arrow
// node on the player prefab, aimed by BarArrowIndicator), not a razor element.
// The Drunk Effect System (Design lines 116-123, 150, 157,
// 164: wobble/blur/chromatic-aberration on timer/score/drunkenness at high beer
// counts) is a deferred separate pass - unimplemented project-wide, not just here.
*@

@namespace Sandbox.UI

@using System
@using Sandbox
@using Sandbox.UI

@inherits PanelComponent

<root>
	@if ( Visible )
	{
		<div class="row @( IsPaused ? "paused" : "" )">
			<div class="stat timer @( TimerClass )">
				<div class="label">TIME</div>
				<div class="value">@TimerText</div>
			</div>

			<div class="stat score">
				<div class="label">SCORE</div>
				<div class="value">@ScoreText</div>
			</div>

			<div class="stat drunk">
				<div class="label">BEERS</div>
				<div class="value"><span class="beer-glyph">@( "\U0001F37A" )</span>@BeersText</div>
			</div>
		</div>

		@if ( IsPaused )
		{
			<div class="paused-banner">TIMER PAUSED</div>
		}

		<div class="controls-hint">
			<div>Move side to side: <b>A</b> and <b>D</b></div>
			<div>Getting Stuck? Press: <b>R</b></div>
			<div>Jump: <b>Spacebar</b></div>
		</div>
	}

	@if ( _ShowPantsDebug && IsPubCrawling )
	{
		<div class="pants-debug-col">
			<div class="pants-debug @( PantsDebugIsDown ? "down" : "up" )">@PantsDebugText</div>
			<div class="pants-debug-hint">P: toggle showing pants debug</div>
		</div>
	}

	@if ( !string.IsNullOrWhiteSpace( _VersionLabel ) )
	{
		<div class="version-label">@_VersionLabel</div>
	}

	@if ( Visible )
	{
		<scene @ref="_previewHost" class="target-bar-preview" />
	}
</root>
