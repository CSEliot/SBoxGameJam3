// Description:
// Pub-crawling HUD overlay (Design.md, Screen 1). Always-visible-during-run
// readout of the live Player List (top-LEFT column of the HUD row - design
// change 09-24: it replaced the standalone center SCORE readout, and remains
// the only score display), Timer (top-center) and Drunkenness (top-right).
// Read-only view over the local player's PlayerProgress/DrunkCC, resolved via
// a [Property] GameManager ref. Hidden during the mini-game (that overlay owns
// the screen) and before the player has spawned. Markup only; display formatting
// lives in Hud.razor.cs.
//
// Also hosts the TARGET-BAR PREVIEW: a ScenePanel (the <scene> tag) rendering the
// current target bar's -JustModel prefab spinning slowly on a slight kilter,
// tucked into the bottom-left corner (the advice-text block was removed 09-25, so
// the frame now owns the corner). Shown under the same Visible gate as the
// HUD body (live run on the street), so it never floats over the menu, the bar
// screens, or the End-Game overlay. Scene setup/spin lives in Hud.razor.cs
// (UpdateTargetBarPreviewHelper). Because ScenePanel composites into the UI layer
// (ScreenPanel, AfterPostProcess), the preview always draws ON TOP of in-world
// models. A red border-only frame wraps the preview with a caption crossing its
// bottom border line (added 09-25).
//
// Not implemented here: the PANTS METER (Design Screen 1, bottom-left) - instead an
// AUTOMATIC right-edge warning blinks once DrunkCC.CurrentPantsState has been
// continuously Down for _PantsDownWarnSeconds (see pants-debug in Hud.razor/scss).
// Also renders the LIVE PLAYER LIST as the top-LEFT column of the HUD row (design
// change 09-24 - it replaced the standalone center SCORE readout and remains the
// only score display; TIME is top-center, BEERS top-right):
// one row per connected player (solo clone included) with their replicated score,
// local row pinned first and magenta; rows are built each frame in Hud.razor.cs
// (UpdatePlayerListHelper), while the render tree itself repaints throttled
// (_TextRefreshRate) so digits tick calmly.
// The Arrow Indicator is a 3D world-space model (the event-arrow
// node on the player prefab, aimed by BarArrowIndicator), not a razor element.
// The Drunk Effect System (Design lines 116-123, 150, 157,
// 164: wobble/blur/chromatic-aberration on timer/score/drunkenness at high beer
// counts) is a deferred separate pass - unimplemented project-wide, not just here.
*@

@namespace Sandbox.UI

@using System
@using Sandbox
@using Sandbox.UI

@inherits PanelComponent

<root>
	@if ( Visible )
	{
		<div class="row @( IsPaused ? "paused" : "" )">
			<div class="stat players">
				<div class="label">PLAYERS</div>
				@foreach ( var row in _playerRows )
				{
					<div class="pl-row @( row.IsLocal ? "local" : "" )">
						<div class="pl-name">@( row.Name )</div>
						<div class="pl-score">@( row.Score.ToString( "D4" ) )</div>
					</div>
				}
			</div>

			<div class="stat timer @( TimerClass )">
				<div class="label">TIME</div>
				<div class="value">@TimerText</div>
			</div>

			<div class="stat drunk">
				<div class="label">BEERS</div>
				<div class="value"><span class="beer-glyph">@( "\U0001F37A" )</span>@BeersText</div>
			</div>
		</div>

		@if ( IsPaused )
		{
			<div class="paused-banner">TIMER PAUSED</div>
		}
	}

	@if ( PantsDebugShown )
	{
		<div class="pants-debug-col">
			<div class="pants-debug @( PantsDebugIsDown ? "down" : "up" )" style="animation-duration: @( PantsBlinkDurationText );">@PantsDebugText</div>
		</div>
	}

	@if ( !string.IsNullOrWhiteSpace( _VersionLabel ) )
	{
		<div class="version-label">@_VersionLabel</div>
	}

	@if ( Visible )
	{
		<div class="bar-preview-frame">
			<scene @ref="_previewHost" class="target-bar-preview" />
			<div class="preview-caption">YOUR NEXT BAR IS</div>
		</div>
	}
</root>
