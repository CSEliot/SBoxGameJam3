<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<AssemblyName>sboxgamejam3</AssemblyName>
		<PackageId>sboxgamejam3</PackageId>
		<LangVersion>14</LangVersion>
		<NoWarn>1701;1702;1591;</NoWarn>
		<WarningsAsErrors></WarningsAsErrors>
		<TreatWarningsAsErrors>False</TreatWarningsAsErrors>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<DefineConstants>SANDBOX</DefineConstants>
		<AllowUnsafeBlocks>False</AllowUnsafeBlocks>
		<OutputPath>/home/cseliot/.local/share/Steam/steamapps/common/sbox/.vs/output/</OutputPath>
		<DocumentationFile>/home/cseliot/.local/share/Steam/steamapps/common/sbox/.vs/output/sboxgamejam3.xml</DocumentationFile>
		<RootNamespace>Sandbox</RootNamespace>
		<Nullable>disable</Nullable>
		<DefaultItemExcludes>$(DefaultItemExcludes);**/editor/**;**/unittest/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="Sandbox.Internal.GlobalGameNamespace" Static="true" />
		<Using Include="Microsoft.AspNetCore.Components" />
		<Using Include="Microsoft.AspNetCore.Components.Rendering" />
	</ItemGroup>
    
	<ItemGroup>
		<Analyzer  Include="/home/cseliot/.local/share/Steam/steamapps/common/sbox/bin/managed/Sandbox.CodeUpgrader.dll"/> 
		<Analyzer  Include="/home/cseliot/.local/share/Steam/steamapps/common/sbox/bin/managed/Sandbox.Generator.dll"/> 
		<Reference Include="/home/cseliot/.local/share/Steam/steamapps/common/sbox/bin/managed/Sandbox.System.dll"/> 
		<Reference Include="/home/cseliot/.local/share/Steam/steamapps/common/sbox/bin/managed/Sandbox.Engine.dll"/> 
		<Reference Include="/home/cseliot/.local/share/Steam/steamapps/common/sbox/bin/managed/Sandbox.Filesystem.dll"/> 
		<Reference Include="/home/cseliot/.local/share/Steam/steamapps/common/sbox/bin/managed/Sandbox.Reflection.dll"/> 
		<Reference Include="/home/cseliot/.local/share/Steam/steamapps/common/sbox/bin/managed/Sandbox.Mounting.dll"/> 
		<Reference Include="/home/cseliot/.local/share/Steam/steamapps/common/sbox/bin/managed/Microsoft.AspNetCore.Components.dll"/> 
	</ItemGroup>

</Project>
